// TnsrLang Phase 9: Mini-GPT (Shakespeare)
// Trains a Language Model using Transformers and JIT Compilation

Print("=========================================")
Print("       MINI-GPT SHAKESPEARE DEMO         ")
Print("=========================================")

Print("Laddar träningsdata...")
let X_data = LoadCSV("data/shakespeare_X.csv")
let Y_data = LoadCSV("data/shakespeare_Y.csv")

let seq_len = 8
let vocab_size = 42
let embed_dim = 64

Print("Initierar Transformer-nätverket...")
let gpt = Sequential([
    // Embedding (konverterar 42 tecken till 64 dimensioner)
    DenseLayer(42, 64),
    
    // Transformer Block (MultiHeadAttention)
    MultiHeadAttentionLayer(64, 4),
    DenseLayer(64, 128),
    ReLULayer(),
    DenseLayer(128, 64),
    
    // Output Layer (Från 64 dimensioner tillbaka till 42 möjliga tecken)
    DenseLayer(64, 42)
])

Print("JIT-Kompilerar nätverket för extrem prestanda...")
let _j = JIT(gpt)
let lr = 0.005

Print("Startar träning (Detta kommer ta en liten stund)...")

for epoch = 1 to 1000 {
    for i = 0 to 662 {
        // Hämta en sekvens från datan
        let x_seq = GetRow(X_data, i) // [1, 8]
        let y_seq = GetRow(Y_data, i) // [1, 8]
        
        // Konvertera till One-Hot kodning
        let x_onehot = OneHot(x_seq, 42)
        let y_onehot = OneHot(y_seq, 42)
        
        // Framåtpass via JIT maskinkod
        let preds = Forward(gpt, x_onehot, 1.0) // [8, 42]
        
        // Beräkna loss (CrossEntropy hanterar softmax + derivata automatiskt)
        let loss = CrossEntropyLoss(preds, y_onehot)
        
        // Bakåtpass
        backward(loss)
        
        // Uppdatera vikter med Adam Optimeraren (mycket snabbare inlärning)
        let _opt = OptimizeAdam(gpt, lr)
        
        if (i > 661) {
            Print("Epoch klar. Senaste Loss:")
            Print(loss)
        }
    }
}

Print("Träning avklarad! Låter AI:n skriva 100 tecken text...")
let seed_sequence = GetRow(X_data, 0)
let _gen = GenerateText(gpt, seed_sequence, 100)
