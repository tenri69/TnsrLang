Print("==========================================")
Print("       TnsrLang XOR Neural Network        ")
Print("==========================================")

let inputs = LoadCSV("xor_inputs.csv")
let targets = LoadCSV("xor_targets.csv")

// 2 Input Neurons, 4 Hidden Neurons, 1 Output Neuron
let w1 = RandomMatrix(4, 2)
let b1 = RandomMatrix(4, 1)

let w2 = RandomMatrix(1, 4)
let b2 = RandomMatrix(1, 1)

let lr = 0.5
let epoch = 0

fn forward(w1, b1, w2, b2, x) {
    let h_raw = DotProduct(w1, x) + b1
    let h = Sigmoid(h_raw)
    let out_raw = DotProduct(w2, h) + b2
    return Sigmoid(out_raw)
}

Print("Training for 500 epochs...")

while epoch < 500 {
    let i = 0
    while i < 4 {
        let x = Transpose(inputs[i])
        let y = targets[i]
        
        let pred = forward(w1, b1, w2, b2, x)
        
        // Native MSELoss calculates the mean squared error
        let loss = MSELoss(pred, y)
        
        backward(loss)
        
        // Native SGD_Step performs the update and clears gradients
        w1 = SGD_Step(w1, lr)
        b1 = SGD_Step(b1, lr)
        w2 = SGD_Step(w2, lr)
        b2 = SGD_Step(b2, lr)
        
        i = i + 1
    }
    epoch = epoch + 1
}

Print("Training Complete!")
Print("==========================================")
Print("Final Predictions:")

let j = 0
while j < 4 {
    let x = Transpose(inputs[j])
    Print(forward(w1, b1, w2, b2, x))
    j = j + 1
}
