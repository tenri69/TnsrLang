Print("Laddar MNIST dataset...")
let data = LoadCSV("mnist_train.csv")
Print("Dataset laddat!")

// Extrahera labels (kolumn 0) och pixlar (kolumn 1-784)
let labels = Slice(data, 0, 1000, 0, 1)
let X = Slice(data, 0, 1000, 1, 785)

// Normalisera pixlar (0-255) till (0-1)
let scale = Vector([0.003921568]) // 1 / 255
let X_norm = X * scale

// One-Hot koda labels (0-9)
let Y = OneHot(labels, 10)

// Initiera vikter för 2-lagers nätverk
// Input: 784, Hidden: 64, Output: 10
let W1 = RandomMatrix(784, 64)
let W2 = RandomMatrix(64, 10)

let lr = Vector([0.05])

Print("Börjar träna på 1000 bilder (Full Batch Gradient Descent)...")

let epoch = 0
while epoch < 100 {
    let _zg = ZeroGrad(W1)
    
    // Framåtpass
    let hidden = ReLU(DotProduct(X_norm, W1))
    let logits = DotProduct(hidden, W2)
    
    // Räkna ut förlust (Loss)
    let loss = CrossEntropyLoss(logits, Y)
    
    if epoch < 1 {
        Print("Initial Loss:")
        Print(loss)
    }
    
    // Bakåtpass
    backward(loss)
    
    // Uppdatera vikter
    W1 = SGD_Step(W1, lr)
    W2 = SGD_Step(W2, lr)
    
    epoch = epoch + 1
}

Print("Träning klar! Slutgiltig Loss:")
// Ett extra framåtpass för att visa final loss
let hidden_final = ReLU(DotProduct(X_norm, W1))
let logits_final = DotProduct(hidden_final, W2)
let final_loss = CrossEntropyLoss(logits_final, Y)
Print(final_loss)

Print("Sparar modellvikter...")
Save(W1, "W1.tnsrdata")
Save(W2, "W2.tnsrdata")
Print("Klart!")
